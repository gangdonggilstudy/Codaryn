# Copy to .env for local use. .env is ignored by Git and must never be committed.
# Codaryn reads it only when asked: codaryn run ... --env-file .env
# Variables already set in the environment win over this file. Save it as UTF-8 without BOM.
# Empty values count as unset. Phase 1a (scripted model) needs none of these.
# The API key belongs here or in the environment only, never in a task or config file.
ANTHROPIC_API_KEY=
# Model id. A task's model.model wins over this; the config file's model is used when both are unset.
CODARYN_MODEL=
# Path of the config file, used when --config is not given.
CODARYN_CONFIG=
# API base URL. Default: the official address. https only (http only on a loopback host, for tests).
CODARYN_API_BASE_URL=
