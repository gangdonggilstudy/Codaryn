{
  "schemaVersion": 1,
  "id": "demo-summary",
  "workflow": "document",
  "goal": "notes.md를 읽고 summary.md에 회의 요약을 만든다. '## 결정 사항'과 '## 할 일' 절을 둔다. notes.md는 바꾸지 않는다.",
  "workspaceRoot": "workspace",
  "model": { "provider": "scripted", "scriptPath": "script.json" },
  "policy": {
    "commands": [],
    "network": "deny",
    "destructive": "deny",
    "restorePathTokens": false,
    "protectedPaths": ["notes.md"]
  },
  "privacy": { "secretEnv": [] },
  "limits": {
    "maxModelTurns": 8,
    "maxToolCalls": 8,
    "maxTotalTokens": 1000,
    "maxDurationMs": 60000,
    "maxRepairAttempts": 1,
    "maxSameFailures": 2
  },
  "verifiers": [
    {
      "id": "summary",
      "kind": "file_rules",
      "rules": [
        { "type": "contains", "path": "summary.md", "text": "## 결정 사항" },
        { "type": "contains", "path": "summary.md", "text": "## 할 일" },
        { "type": "contains", "path": "notes.md", "text": "# 주간 회의 메모" }
      ]
    }
  ]
}
