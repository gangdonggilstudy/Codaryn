{
  "name": "codaryn",
  "version": "0.1.0",
  "private": true,
  "description": "General-purpose local task agent (CLI first). Phase 1a: offline foundation.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "bin": {
    "codaryn": "dist/src/cli/main.js"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test:unit": "npm run build && node --test \"dist/tests/unit/**/*.test.js\"",
    "test:integration": "npm run build && node --test \"dist/tests/integration/**/*.test.js\"",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
